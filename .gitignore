**/*.rs.bk
**/Cargo.lock
**/rusty-tags.vi
/.agents
/.cargo
/.claude
/.codex
/.vscode
/build
/rpm/SOURCES
/target
/vendor
__pycache__

# Gimbal Local runtime artifacts (large, machine-local snapshots + COW overlays).
# Captured snapshot bundles (RAM image + multi-GB disk images) and per-run
# copy-on-write overlays must never be committed.
/snapshots/
**/.chm-overlays/
# Per-run overlays, live checkpoints, the revision store, and the desktop app's
# per-sandbox workspace dirs are all machine-local runtime state the app/daemon
# create under the working directory; never commit them.
**/.chm-revisions/
**/.chm-checkpoint/
/.chm-workspaces/

# bench python cache
scripts/bench/__pycache__/
